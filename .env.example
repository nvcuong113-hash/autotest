# AI provider: Google Gemini (no OpenAI API key required)
AI_PROVIDER=gemini
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_API_KEY=replace_with_google_ai_studio_api_key

# Persistent database
DATABASE_URL=postgresql://user:password@host-pooler/database?sslmode=require

# Separate Playwright Browser Runner
RUNNER_URL=https://your-runner.onrender.com
RUNNER_API_TOKEN=replace_with_a_long_random_token

# Optional local-only SQLite path (ignored when DATABASE_URL is set)
# AUTOTEST_DB=data/autotest.sqlite3
